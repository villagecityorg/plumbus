---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// All posts for simple infinite scroll layout
const allPosts = posts;

const hdImages = {
  portal1: "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=2048&q=95",
  portal2: "https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?w=2048&q=95",
  texture: "https://images.unsplash.com/photo-1579546929662-711aa81148cf?w=2048&q=95"
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style define:vars={{
			portalBg1: `url(${hdImages.portal1})`,
			portalBg2: `url(${hdImages.portal2})`,
			textureBg: `url(${hdImages.texture})`
		}}>
			:root {
				--primary: #2a623d;
				--primary-dark: #1a472a;
				--secondary: #97ce4c;
				--text: #e0e0e0;
				--background: #0d1f13;
				--accent: #44281d;
				--glow: rgba(151, 206, 76, 0.3);
			}

			body {
				margin: 0;
				font-family: 'Atkinson', sans-serif;
				background: var(--background);
				color: var(--text);
				overflow-x: hidden;
			}

			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.portal-bg {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: 
					radial-gradient(circle at 10% 20%, rgba(42, 98, 61, 0.4) 0%, transparent 50%),
					radial-gradient(circle at 90% 80%, rgba(151, 206, 76, 0.2) 0%, transparent 50%),
					var(--background);
				z-index: -1;
				&::before {
					content: '';
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					background: var(--textureBg) center/cover;
					opacity: 0.05;
					mix-blend-mode: overlay;
				}
			}

			.blog-header {
				padding: 6rem 2rem;
				text-align: left;
				position: relative;
				background: rgba(26, 71, 42, 0.3);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid rgba(151, 206, 76, 0.1);
				&::before {
					content: '';
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					background: var(--portalBg1) center/cover;
					opacity: 0.1;
					mix-blend-mode: overlay;
					z-index: -1;
				}
			}

			.blog-header h1 {
				font-size: clamp(3rem, 6vw, 5rem);
				color: var(--secondary);
				margin: 0;
				text-shadow: 
					0 0 10px var(--glow),
					0 0 20px var(--glow),
					0 0 40px var(--glow);
			}

			.blog-header p {
				font-size: clamp(1.2rem, 2vw, 1.5rem);
				max-width: 800px;
				margin: 2rem 0 0 0;
				opacity: 0.9;
			}

			.blog-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				padding: 4rem 2rem;
				max-width: 2400px;
				margin: 0 auto;
			}

			.blog-card {
				background: rgba(26, 71, 42, 0.3);
				border-radius: 20px;
				overflow: hidden;
				backdrop-filter: blur(10px);
				border: 1px solid rgba(151, 206, 76, 0.1);
				transition: all 0.3s ease;
				height: 100%;
				display: flex;
				flex-direction: column;
			}

			.blog-card:hover {
				transform: translateY(-10px);
				box-shadow: 
					0 10px 30px rgba(0, 0, 0, 0.3),
					0 0 20px var(--glow);
				border-color: rgba(151, 206, 76, 0.3);
			}

			.blog-image {
				width: 100%;
				height: 200px;
				object-fit: cover;
			}

			.blog-content {
				padding: 1.5rem;
				flex-grow: 1;
				display: flex;
				flex-direction: column;
			}

			.blog-title {
				color: var(--secondary);
				font-size: 1.5rem;
				margin: 0 0 1rem 0;
				line-height: 1.2;
				text-shadow: 0 0 10px var(--glow);
			}

			.blog-date {
				color: rgba(var(--text), 0.7);
				font-size: 0.9rem;
				margin-bottom: 1rem;
			}

			.blog-description {
				color: var(--text);
				margin: 0;
				flex-grow: 1;
				line-height: 1.6;
			}

			.blog-link {
				text-decoration: none;
				color: inherit;
				display: block;
				height: 100%;
			}

			.featured-post {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				background: rgba(26, 71, 42, 0.5);
				padding: 2rem;
				border-radius: 30px;
				margin-bottom: 2rem;
			}

			.featured-post .blog-image {
				height: 400px;
				border-radius: 20px;
			}

			.featured-post .blog-content {
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.featured-post .blog-title {
				font-size: 2.5rem;
			}

			.featured-post .blog-description {
				font-size: 1.2rem;
			}

			.featured-section {
				padding: 4rem 2rem;
				max-width: 2400px;
				margin: 0 auto;
			}

			.featured-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2rem;
			}

			.regular-section {
				padding: 0 2rem 4rem 2rem;
				max-width: 2400px;
				margin: 0 auto;
				text-align: center;
			}

			.regular-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				margin-bottom: 3rem;
			}

			.load-more-btn {
				background: var(--secondary);
				color: var(--primary-dark);
				border: none;
				padding: 1rem 2rem;
				border-radius: 50px;
				font-size: 1rem;
				font-weight: bold;
				cursor: pointer;
				transition: all 0.3s ease;
				text-transform: uppercase;
				letter-spacing: 1px;
			}

			.load-more-btn:hover {
				background: #a8e650;
				transform: translateY(-2px);
				box-shadow: 0 5px 15px rgba(151, 206, 76, 0.3);
			}

			.load-more-btn:disabled {
				background: var(--primary-dark);
				color: var(--text);
				cursor: not-allowed;
				opacity: 0.6;
			}

			@media (max-width: 1024px) {
				.featured-post {
					grid-template-columns: 1fr;
				}

				.featured-post .blog-image {
					height: 300px;
				}
			}

			@media (max-width: 768px) {
				.blog-grid {
					grid-template-columns: 1fr;
					padding: 2rem 1rem;
				}

				.blog-header {
					padding: 4rem 1rem;
				}

				.featured-post .blog-title {
					font-size: 2rem;
				}

				.featured-section,
				.regular-section {
					padding: 2rem 1rem;
				}

				.regular-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<div class="portal-bg"></div>
		<Header />
		<main>
			<div class="blog-header">
				<h1>VCC Morse Radio Blog</h1>
				<p>Vibe training Morse radio over mesh networks</p>
			</div>
			
			<!-- Featured Posts Section (Temporarily Hidden) -->
			<!-- <div class="featured-section">
				<div class="featured-grid">
					{allFeaturedPosts.map((post) => (
						<div class="featured-post">
							<a href={`/blog/${post.id}/`} class="blog-link">
								<article class="blog-card">
									<img 
										src={post.data.heroImage} 
										alt="" 
										class="blog-image"
									/>
									<div class="blog-content">
										<h2 class="blog-title">{post.data.title}</h2>
										<div class="blog-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<p class="blog-description">{post.data.description}</p>
									</div>
								</article>
							</a>
						</div>
					))}
				</div>
			</div> -->

			<!-- All Posts with Infinite Scroll -->
			<div class="regular-section">
				<div id="posts-container" class="regular-grid">
					{allPosts.slice(0, 6).map((post) => (
						<a href={`/blog/${post.id}/`} class="blog-link">
							<article class="blog-card">
								<img 
									src={post.data.heroImage} 
									alt="" 
									class="blog-image"
								/>
								<div class="blog-content">
									<h3 class="blog-title">{post.data.title}</h3>
									<div class="blog-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<p class="blog-description">{post.data.description}</p>
								</div>
							</article>
						</a>
					))}
				</div>
				
				{allPosts.length > 6 && (
					<button id="load-more" class="load-more-btn">
						Load More Posts
					</button>
				)}
			</div>
		</main>
		<Footer />
		
		<script>
			// All posts data for infinite scroll
			const allPosts = JSON.parse(decodeURIComponent("{encodeURIComponent(JSON.stringify(allPosts))}"));
			let currentIndex = 6;
			const postsPerLoad = 6;

			const loadMoreBtn = document.getElementById('load-more');
			const postsContainer = document.getElementById('posts-container');

			function createPostCard(post) {
				return `
					<a href="/blog/${post.id}/" class="blog-link">
						<article class="blog-card">
							<img 
								src="${post.data.heroImage}" 
								alt="" 
								class="blog-image"
							/>
							<div class="blog-content">
								<h3 class="blog-title">${post.data.title}</h3>
								<div class="blog-date">
									${new Date(post.data.pubDate).toLocaleDateString('en-US', { 
										year: 'numeric', 
										month: 'short', 
										day: 'numeric' 
									})}
								</div>
								<p class="blog-description">${post.data.description}</p>
							</div>
						</article>
					</a>
				`;
			}

			function loadMorePosts() {
				const nextPosts = allPosts.slice(currentIndex, currentIndex + postsPerLoad);
				
				nextPosts.forEach(post => {
					const postHTML = createPostCard(post);
					postsContainer.insertAdjacentHTML('beforeend', postHTML);
				});

				currentIndex += postsPerLoad;

				// Disable button if all posts are loaded
				if (currentIndex >= allPosts.length) {
					loadMoreBtn.textContent = 'All Posts Loaded';
					loadMoreBtn.disabled = true;
				}

				// Add fade-in animation to new posts
				const newPosts = postsContainer.querySelectorAll('.blog-card:nth-last-child(-n+' + nextPosts.length + ')');
				newPosts.forEach((post, index) => {
					post.style.opacity = '0';
					post.style.transform = 'translateY(20px)';
					setTimeout(() => {
						post.style.transition = 'all 0.5s ease';
						post.style.opacity = '1';
						post.style.transform = 'translateY(0)';
					}, index * 100);
				});
			}

			// Load more posts when button is clicked
			if (loadMoreBtn) {
				loadMoreBtn.addEventListener('click', loadMorePosts);
			}

			// Optional: Auto-load more posts when scrolling near bottom
			let isLoading = false;
			window.addEventListener('scroll', () => {
				if (isLoading || !loadMoreBtn || loadMoreBtn.disabled) return;

				const scrollPosition = window.innerHeight + window.scrollY;
				const documentHeight = document.documentElement.scrollHeight;
				
				if (scrollPosition >= documentHeight - 1000) { // Load when 1000px from bottom
					isLoading = true;
					loadMorePosts();
					setTimeout(() => {
						isLoading = false;
					}, 1000);
				}
			});
		</script>
	</body>
</html>
