		<script>
			class MorseAnimator {
				constructor(element, morseString) {
					this.element = element;
					this.morseString = morseString;
					this.isAnimating = false;
				}

				createMorseElement(type, delay) {
					const span = document.createElement('span');
					span.className = `morse-char ${type}`;
					span.style.animationDelay = `${delay}s`;
					
					if (type === 'dot') {
						span.textContent = '·';
					} else if (type === 'dash') {
						span.textContent = '—';
					} else if (type === 'space') {
						span.textContent = '';
					} else if (type === 'word-gap') {
						span.textContent = '';
					}
					
					return span;
				}

				animate() {
					if (this.isAnimating) return;
					this.isAnimating = true;
					
					// Clear existing content
					this.element.innerHTML = '';
					
					// Create elements for each character
					const elements = [];
					let delay = 0;
					const charDelay = 0.15; // Delay between characters
					
					for (let i = 0; i < this.morseString.length; i++) {
						const char = this.morseString[i];
						
						if (char === '.') {
							elements.push(this.createMorseElement('dot', delay));
							delay += charDelay;
						} else if (char === '-') {
							elements.push(this.createMorseElement('dash', delay));
							delay += charDelay;
						} else if (char === ' ') {
							elements.push(this.createMorseElement('space', delay));
							delay += charDelay * 0.5;
						} else if (char === '/') {
							elements.push(this.createMorseElement('word-gap', delay));
							delay += charDelay * 0.5;
						}
					}
					
					// Add cursor at end
					const cursor = document.createElement('span');
					cursor.className = 'morse-cursor';
					cursor.style.animationDelay = `${delay}s`;
					elements.push(cursor);
					
					// Add all elements to container
					elements.forEach(el => this.element.appendChild(el));
					
					// Restart animation after completion
					const totalDuration = delay + 2;
					setTimeout(() => {
						this.isAnimating = false;
						// Auto-restart after a pause
						setTimeout(() => this.animate(), 3000);
					}, totalDuration * 1000);
				}
			}

			// Initialize animations when page loads
			document.addEventListener('DOMContentLoaded', () => {
				const morseElements = document.querySelectorAll('.morse-animation');
				
				morseElements.forEach((element, index) => {
					const morseString = element.getAttribute('data-morse');
					if (morseString) {
						// Stagger the start of each animation
						setTimeout(() => {
							const animator = new MorseAnimator(element, morseString);
							animator.animate();
						}, index * 500);
					}
				});
			});
		</script>
