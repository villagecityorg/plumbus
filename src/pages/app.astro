---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
import productData from '../content/data/main.json';

const { product } = productData;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={`VCC Morse Radio Training | ${SITE_TITLE}`} 
			description="Join our comprehensive VCC Morse radio training network - No Galactic Federation ID required"
		/>
		<style>
			:root {
				--primary: #2a623d;
				--primary-dark: #1a472a;
				--secondary: #97ce4c;
				--text: #e0e0e0;
				--background: #0d1f13;
				--accent: #44281d;
				--glow: rgba(151, 206, 76, 0.3);
			}

			body {
				margin: 0;
				font-family: 'Space Grotesk', sans-serif;
				background: var(--background);
				color: var(--text);
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}

			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
				text-align: center;
				background: rgba(26, 71, 42, 0.3);
				border-radius: 20px;
				backdrop-filter: blur(10px);
				border: 1px solid rgba(151, 206, 76, 0.2);
				box-shadow: 
					0 0 20px var(--glow),
					0 0 40px var(--glow);
			}

			h1 {
				color: var(--secondary);
				font-size: clamp(2rem, 5vw, 4rem);
				margin-bottom: 2rem;
				text-shadow: 
					0 0 10px var(--glow),
					0 0 20px var(--glow);
			}

			.training-logo {
				width: 150px;
				height: 150px;
				margin: 2rem auto;
				background: url('/cover-morse-radio.jpg') center/contain no-repeat;
				opacity: 0.8;
				filter: drop-shadow(0 0 10px var(--glow));
				border-radius: 10px;
			}

			.message {
				font-size: 1.2rem;
				line-height: 1.6;
				margin-bottom: 2rem;
				padding: 1rem;
				background: rgba(151, 206, 76, 0.1);
				border-radius: 10px;
			}

			.training-features-title {
				color: var(--secondary);
				font-weight: bold;
				font-size: 1.1rem;
				margin: 1.5rem 0 1rem 0;
				text-shadow: 
					0 0 10px var(--glow),
					0 0 20px var(--glow),
					0 0 30px var(--glow);
				animation: pulse-glow 2s ease-in-out infinite alternate;
			}

			@keyframes pulse-glow {
				0% {
					text-shadow: 
						0 0 10px var(--glow),
						0 0 20px var(--glow),
						0 0 30px var(--glow);
				}
				100% {
					text-shadow: 
						0 0 15px var(--secondary),
						0 0 25px var(--secondary),
						0 0 35px var(--secondary);
				}
			}

			.welcome {
				color: var(--secondary);
				font-style: italic;
				font-size: 0.9rem;
				margin-top: 2rem;
			}

			.close-button {
				display: inline-block;
				margin: 1rem 1rem 2rem 1rem;
				padding: 1rem 2rem;
				background: #ef4444;
				color: white;
				text-decoration: none;
				border-radius: 50px;
				font-weight: bold;
				transition: all 0.3s ease;
				border: none;
				cursor: pointer;
				font-size: 1rem;
			}

			.close-button:hover {
				background: #dc2626;
				transform: translateY(-3px);
				box-shadow: 0 5px 15px rgba(239, 68, 68, 0.3);
			}

			.back-link {
				display: none;
				margin-top: 2rem;
				padding: 1rem 2rem;
				background: var(--secondary);
				color: var(--background);
				text-decoration: none;
				border-radius: 50px;
				font-weight: bold;
				transition: all 0.3s ease;
			}

			.back-link:hover {
				transform: translateY(-3px);
				box-shadow: 0 5px 15px rgba(151, 206, 76, 0.3);
			}

			@media (max-width: 768px) {
				.container {
					margin: 1rem;
					padding: 1rem;
				}

				h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="container">
			<h1>VCC Morse Radio - Coming Soon...</h1>
			<div class="message">
				<p>📡 CHOOSE YOUR TRAINING PATH 📡</p>
				<p>
					VCC Morse Radio offers a flexible, tiered training system designed to meet every learner's needs, 
					from casual beginners to dedicated enthusiasts. Start immediately with our free web-based trainer.
				</p>
				<p>No registration required - begin your Morse code journey right now!</p>
				<p class="training-features-title">
					Free Trainer Package - Start Zero Cost
				</p>
				<ul style="text-align: left; list-style-position: inside;">
					<li>Keyboard-based Morse practice (Straight Key and Iambic Paddle)</li>
					<li>Observe live radio conversations from experienced operators</li>
					<li>Personal trainer chat for private practice sessions</li>
				</ul>
				<p class="training-features-title">
					Paddle Trainer Package - Full Community Integration:
				</p>
				<ul style="text-align: left; list-style-position: inside;">
					<li>Join live conversations with other members worldwide</li>
					<li>Customizable training programs for your skill level</li>
					<li>Ad-free interface with priority support</li>
				</ul>
				<p class="training-features-title">
					Pro Trainer Package - Professional Hardware Integration:
				</p>
				<ul style="text-align: left; list-style-position: inside;">
					<li>Wi-Fi-enabled touch-LCD ultra-mini computer</li>
					<li>Standalone operation with authentic paddle hardware</li>
					<li>Complete hardware + software integration</li>
				</ul>
			</div>
			<p class="welcome">
				* Your path to Morse mastery begins with a single key press - and grows into a lifetime 
				of communication and community. Start free, progress at your pace, and achieve your goals 
				with the perfect combination of software and hardware tools for your Morse code journey.
			</p>
			<button onclick="window.close()" class="close-button">Close</button>
		</div>
	</body>
</html>
